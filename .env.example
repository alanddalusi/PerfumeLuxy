# Stripe Configuration
# Get your keys from: https://dashboard.stripe.com/apikeys
STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key_here
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# Database Configuration (if using PostgreSQL in production)
# DATABASE_URL=postgresql://username:password@localhost:5432/eau_royal

# Email Configuration (if using email backend)
# EMAIL_HOST_USER=your_email@gmail.com
# EMAIL_HOST_PASSWORD=your_app_password

# AWS S3 Configuration (if using S3 for media files)
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_STORAGE_BUCKET_NAME=your_s3_bucket_name

# Debug Configuration
# DEBUG=True

# Secret Key (generate a new one for production)
# SECRET_KEY=your_secret_key_here