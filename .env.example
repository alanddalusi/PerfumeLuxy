# Export these variables in the process environment. The file is an example.
DJANGO_ENV=development
STORE_MODE=prelaunch

# Production requires a unique signing key, explicit hosts and a PostgreSQL URL.
# SECRET_KEY=
# DJANGO_ALLOWED_HOSTS=perfumeria.example.com
# DATABASE_URL=postgresql://user:password@db.example.com:5432/perfumeria?sslmode=verify-full
# DJANGO_CSRF_TRUSTED_ORIGINS=https://perfumeria.example.com

# Enable only behind a proxy that strips/overwrites X-Forwarded-Proto from clients.
# DJANGO_TRUST_HTTPS_PROXY=1
# Enable only after confirming HTTPS on every subdomain.
# DJANGO_HSTS_INCLUDE_SUBDOMAINS=1
# DJANGO_HSTS_PRELOAD=1

# Override production SMTP defaults when using a different provider.
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=

# Outside publicly served directories. Share between application instances if needed.
# CATALOG_ASSET_ROOT=/srv/perfumeria/catalog_assets
# Keep disabled until mail and privacy are approved. Ignored in development.
# INTEREST_EMAIL_DELIVERY=0

# Optional S3 storage (credentials can come from the AWS provider chain).
# USE_AWS=1
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=
# AWS_S3_CUSTOM_DOMAIN=

# Future commerce. Leave credentials unset during prelaunch.
# STRIPE_PUBLIC_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
