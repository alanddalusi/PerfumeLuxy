# Files executed or parsed inside Linux containers must keep LF endings.
*.sh text eol=lf
Dockerfile text eol=lf
deploy/Caddyfile text eol=lf
deploy/*.yaml text eol=lf
deploy/*.py text eol=lf
deploy/env.production.example text eol=lf
# Everything under deploy/ runs or is parsed on Linux hosts.
deploy/** text eol=lf
