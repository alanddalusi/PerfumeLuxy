# Copy to deploy/shared/.env.production on the VPS (chmod 600). Never commit the real file.
# Values in <> must be supplied by the operator.

# Stack layout (read by the backup/restore scripts; keep as is).
COMPOSE_FILE=shared/compose.yaml
COMPOSE_PROJECT_NAME=perfumeria-production
WEB_SERVICE=perfumeria-web
DB_SERVICE=perfumeria-db
# Empty on purpose: the proxy belongs to Foro IA al Día and is never stopped by our scripts.
PROXY_SERVICE=

# Release = git commit deployed (image tag perfumeria-web:<RELEASE>; keep the previous one for rollback).
RELEASE=<git-commit>

SITE_DOMAIN=perfumeriaelbuenolor.es
DJANGO_ALLOWED_HOSTS=perfumeriaelbuenolor.es
DJANGO_CSRF_TRUSTED_ORIGINS=https://perfumeriaelbuenolor.es
# python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=<unique-random-value>

POSTGRES_DB=perfumeria
POSTGRES_USER=perfumeria
# Letters and digits only (embedded in DATABASE_URL):
# python3 -c "import secrets,string; print(''.join(secrets.choice(string.ascii_letters+string.digits) for _ in range(40)))"
POSTGRES_PASSWORD=<unique-random-value>

# Forum infrastructure this project attaches to (verified by shared/preflight.sh).
SHARED_EDGE_NETWORK=foroia-production_edge
SHARED_PROXY_CONTAINER=foroia-production-caddy-1

GUNICORN_WORKERS=2
GUNICORN_THREADS=2

# STORE_MODE, EMAIL_DELIVERY, INTEREST_EMAIL_DELIVERY and Stripe keys are pinned in
# shared/compose.yaml (prelaunch, disabled, 0, empty). Do not add them here.

BACKUP_DIR=/srv/perfumeria/backups
BACKUP_KEEP_DAYS=14

# Datos reales del titular (LSSI-CE / RGPD). Mientras falte alguno obligatorio, las páginas
# /aviso-legal/, /politica-de-privacidad/ y /contacto/ responden 404 y no se enlazan.
LEGAL_OWNER_NAME=
LEGAL_OWNER_TAX_ID=
LEGAL_OWNER_ADDRESS=
LEGAL_OWNER_EMAIL=
# Opcionales
LEGAL_OWNER_PHONE=
LEGAL_OWNER_REGISTRY=
# Proveedor de envío de correo (cuando se active el SMTP), p. ej. el nombre del servicio
LEGAL_EMAIL_PROVIDER=

# Política de la tienda acordada con el proveedor (solo valores reales). Sin los obligatorios,
# /garantia-de-autenticidad/ y /envios-y-devoluciones/ responden 404 y no se enlazan.
SHOP_SUPPLIER_AUTHORIZED=
SHOP_GOODS_ORIGIN=
SHOP_DELIVERY_DAYS=
SHOP_SHIPPING_COST=
SHOP_RETURN_DAYS=
# Opcionales
SHOP_CARRIER=
SHOP_FREE_SHIPPING_FROM=
SHOP_SAMPLES_INCLUDED=
