From 13cff12150a0c6721b317d5ddbc82b2e50c0fe61 Mon Sep 17 00:00:00 2001
From: DevelopersIslamic <developersislamic@gmail.com>
Date: Fri, 20 Nov 2026 00:55:17 +0100
Subject: [PATCH] deploy(caddy): servir perfumeriaelbuenolor.es desde el Caddy
 compartido
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Añade un bloque delimitado (BEGIN/END perfumeria-el-buen-olor) que
redirige www al dominio principal y hace de proxy a perfumeria-web:8000
en la red foroia-production_edge. No cambia ningún sitio del foro.

- /media/, /healthz y archivos ocultos devuelven 404.
- Log propio en /data/perfumeria/access.log con tokens redactados e IP
  enmascaradas; rotación 20 MiB x 10, 30 días.
- Validado con caddy 2.11.7 (imagen del foro): rc=0, sin avisos nuevos.

Retirar: borrar las líneas entre los marcadores y desplegar el foro.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 deploy/Caddyfile | 57 ++++++++++++++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 57 insertions(+)

diff --git a/deploy/Caddyfile b/deploy/Caddyfile
index 616825d..414339c 100644
--- a/deploy/Caddyfile
+++ b/deploy/Caddyfile
@@ -35,3 +35,60 @@ http://www.foroiaaldia.com {
 www.foroiaaldia.com {
     redir https://foroiaaldia.com{uri} permanent
 }
+
+# >>> BEGIN perfumeria-el-buen-olor (managed block: added and removed only by deploy/shared/caddy-*.sh)
+# Perfumería El Buen Olor. Proxies to the perfumeria-web container on the shared edge network.
+www.perfumeriaelbuenolor.es {
+    redir https://perfumeriaelbuenolor.es{uri} permanent
+}
+
+perfumeriaelbuenolor.es {
+    encode zstd gzip
+
+    header {
+        ?Strict-Transport-Security "max-age=31536000"
+        ?X-Content-Type-Options "nosniff"
+        ?Referrer-Policy "strict-origin-when-cross-origin"
+        ?X-Frame-Options "DENY"
+        -Server
+        -Via
+    }
+
+    # Originals and the internal health endpoint are never public.
+    @perfumeria_private path /media/* /healthz* /.env* /.git*
+    respond @perfumeria_private 404
+
+    reverse_proxy perfumeria-web:8000 {
+        # Caddy 2.11 already replaces client-sent X-Forwarded-For/-Proto with values from the
+        # connection (no trusted_proxies configured); Django trusts only this proxy's address.
+        header_up -X-Real-IP
+    }
+
+    log {
+        output file /data/perfumeria/access.log {
+            roll_size 20MiB
+            roll_keep 10
+            roll_keep_for 720h
+        }
+        format filter {
+            wrap json
+            fields {
+                # One-time confirmation, withdrawal, e-mail verification and password-reset tokens.
+                request>uri regexp "(/(?:confirmar|baja)/|/confirm-email/|/password/reset/key/)[^/?]+" "$1[redacted]"
+                request>headers>Cookie delete
+                request>headers>Authorization delete
+                request>headers>Referer delete
+                resp_headers>Set-Cookie delete
+                request>remote_ip ip_mask {
+                    ipv4 24
+                    ipv6 48
+                }
+                request>client_ip ip_mask {
+                    ipv4 24
+                    ipv6 48
+                }
+            }
+        }
+    }
+}
+# <<< END perfumeria-el-buen-olor
-- 
2.9.0.windows.1

