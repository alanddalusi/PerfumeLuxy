# Copy to deploy/.env.production on the server (chmod 600). Never commit the real file.
# Values in <> must be supplied by the business owner / operator.

SITE_DOMAIN=<perfumeria.example>
ACME_EMAIL=<operador@example>
RELEASE=<git-commit-or-tag>

DJANGO_ALLOWED_HOSTS=<perfumeria.example>
DJANGO_CSRF_TRUSTED_ORIGINS=https://<perfumeria.example>
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=<unique-random-value>

POSTGRES_DB=perfumeria
POSTGRES_USER=perfumeria
# Letters and digits only (it is embedded in DATABASE_URL). Generate with:
# python -c "import secrets,string; print(''.join(secrets.choice(string.ascii_letters+string.digits) for _ in range(40)))"
POSTGRES_PASSWORD=<unique-random-value>

# Prelaunch guard rails: keep exactly as they are for this release.
STORE_MODE=prelaunch
EMAIL_DELIVERY=disabled
INTEREST_EMAIL_DELIVERY=0

# SMTP (only after the privacy texts and provider contract are approved):
# EMAIL_DELIVERY=smtp
# EMAIL_HOST=<smtp.proveedor>
# EMAIL_PORT=587
# EMAIL_USE_SSL=0
# EMAIL_HOST_USER=<usuario>
# EMAIL_HOST_PASSWORD=<secreto>
# DEFAULT_FROM_EMAIL=Perfumería El Buen Olor <avisos@perfumeria.example>

# Enable only once every subdomain serves HTTPS.
# DJANGO_HSTS_INCLUDE_SUBDOMAINS=1

# Payments stay unconfigured during prelaunch. Do not set Stripe keys.

# Backups (deploy/backup/backup.sh)
BACKUP_DIR=/srv/perfumeria/backups
BACKUP_KEEP_DAYS=14
